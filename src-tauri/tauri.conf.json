{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BESSForge",
  "version": "1.0.1",
  "identifier": "com.eci.bessforge",
  "build": {
    "frontendDist": "../dist/static/app",
    "beforeBuildCommand": "npm run build:static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BESSForge — BESS 10% Design Tool",
        "width": 1600,
        "height": 950,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; form-action 'none'; script-src 'self' blob: 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob: https:; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' https: http://127.0.0.1:* http://localhost:* http://[::1]:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": ["bessforge.config.json", "../BUILD-PROVENANCE.json"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
