{
  "name": "bessforge-eci-epcs",
  "version": "1.0.1",
  "private": true,
  "description": "ECI-EPCS proprietary battery energy storage system design software",
  "author": "ECI Electrical Consultants, Inc.",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:static": "vite build --base=./ --outDir ../dist/static/app --emptyOutDir",
    "package:static": "npm run build:static && tsx scripts/package-static.ts",
    "build:installer": "node scripts/build-windows-installer.mjs",
    "package:release": "npm run package:complete",
    "package:complete": "node scripts/build-complete-release.mjs",
    "verify:sanitized-source": "node scripts/build-release-package.mjs --verify-source-only",
    "test:release-integrity": "node scripts/build-release-package.mjs --self-test",
    "tauri": "tauri",
    "check": "tsc --noEmit",
    "lint": "eslint client/src server scripts --max-warnings=0",
    "test": "npm run test:services && tsx --tsconfig scripts/tsconfig.test.json scripts/elevation.test.ts && tsx --tsconfig scripts/tsconfig.test.json scripts/enlarged-print.test.ts",
    "test:services": "tsx --tsconfig scripts/tsconfig.test.json scripts/api-base.test.ts && tsx --tsconfig scripts/tsconfig.test.json scripts/offline-sitepack.test.ts && tsx --tsconfig scripts/tsconfig.test.json scripts/proxy-hardening.test.ts",
    "test:sanitized-core": "npm run test:services && tsx --tsconfig scripts/tsconfig.test.json scripts/elevation.test.ts && tsx --tsconfig scripts/tsconfig.test.json scripts/enlarged-print.test.ts",
    "test:release": "npm run test:services && tsx --tsconfig scripts/tsconfig.test.json scripts/elevation.test.ts && tsx --tsconfig scripts/tsconfig.test.json scripts/enlarged-print.test.ts",
    "audit:security": "npm audit --audit-level=moderate",
    "audit:release": "node scripts/audit-release.mjs . --report dist/source-audit-report.json"
  },
